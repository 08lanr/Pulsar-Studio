# Copy to .env.local. Never commit .env.local.

# --- Supabase (shared project with Reach and Stage) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - used by ingest jobs and admin routes only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data source -------------------------------------------------------------
# fixture  = render from the bundled sample title (no Supabase needed; default in dev)
# supabase = read/write the shared Supabase project
DATA_SOURCE=fixture

# --- Video (Cloudflare Stream) -----------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# --- AI / dubbing providers (external APIs, not self-hosted) ------------------
ANTHROPIC_API_KEY=
# Only for identity-linked keys: the workspace the requests act in
# (console.anthropic.com -> Settings -> Workspaces, id starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=
# Dubbing / TTS provider is an OPEN decision - see docs/build-plan.md.
DUBBING_API_KEY=
