# Copy to .env.local. Never commit .env.local.

# --- Supabase (shared project with Reach and Stage) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - used by ingest jobs and admin routes only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data source -------------------------------------------------------------
# fixture  = render from the bundled sample title (no Supabase needed; default in dev)
# supabase = read/write the shared Supabase project
DATA_SOURCE=fixture

# --- Video (Cloudflare Stream) -----------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# --- AI providers -------------------------------------------------------------
# anthropic (default), openai or deepseek. Only the chosen provider's key is read.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only for identity-linked keys: the workspace the requests act in
# (console.anthropic.com -> Settings -> Workspaces, id starts with wrkspc_).
# Such a key without it answers 400 to every call ("not scoped to a workspace");
# the gateway reports that as unavailable, naming this variable, and the frame
# judge (which prefers Anthropic whenever ANTHROPIC_API_KEY is set) stops at the
# first such answer and waits for a hand-off instead of paying for doomed calls.
ANTHROPIC_WORKSPACE_ID=
# Engineers only (decision 2026-09-23 "The frame judge on Claude, measured"). A
# FORCED tool call skips the model's thinking (0 of 40 turns thought first) and
# `auto` plus "Answer only by calling <tool>" thinks first (41 of 41), so blank =
# each call's own preference: the frame judge (reviewer, skeptic, tie-break, band
# fix) asks for auto, the adaptation passes are forced where the model accepts it.
# `auto` sends every call that way; `forced` forces the judge too where the model
# accepts it (the cheap comparison arm: Sonnet 5 scored 14/20 either way). Opus
# 5.5 and Fable 5.1 refuse a forced call and are auto regardless.
ANTHROPIC_TOOL_CHOICE=
OPENAI_API_KEY=
# platform.deepseek.com -> API keys. Defaults: deepseek-flash (fast, reads images),
# deepseek-v4-pro (strong). deepseek-chat / deepseek-reasoner were discontinued 2026-07-24.
# The fast tier runs with thinking off; the strong tier thinks at the call's effort
# with room for the reasoning on top of the call's own budget (lib/llm.ts, deepSeekReasoning).
DEEPSEEK_API_KEY=
# Optional; the OpenAI-compatible host, https://api.deepseek.com unless set.
DEEPSEEK_BASE_URL=
# Optional provider-specific overrides of the two tiers (the reading passes and
# the writing passes). Defaults are selected in lib/llm.ts. Neither moves the
# frame judge, which has its own model (ADS_VISION_MODEL below).
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
# Per-call providers for the ad engine (decision 2026-09-22). Text nomination runs on
# ADS_TEXT_PROVIDER (default deepseek); the frame judge on ADS_VISION_PROVIDER
# (default anthropic on claude-opus-5-5 — measured 2026-09-23, "The frame judge on
# Claude, measured": 16/20 and 17/20 against claude-sonnet-5's 14/20 and 12/20,
# about $0.15 per boundary, $9.60 per film; with no ANTHROPIC_API_KEY and a
# DEEPSEEK_API_KEY it runs on deepseek-flash). An explicitly named provider is
# never swapped: its missing key shows as "vision provider unavailable" on the ads
# page.
ADS_TEXT_PROVIDER=
ADS_VISION_PROVIDER=
# The frame judge's model, in place of the provider's vision default (anthropic
# claude-opus-5-5, deepseek deepseek-flash). It must be the judge's provider's own
# (a Claude id under ADS_VISION_PROVIDER=deepseek is refused, not swapped) and read
# images. The eval's --model tries another model for one run without setting it.
ADS_VISION_MODEL=

# --- Workspace import (decision 2026-09-22) -----------------------------------
# The mini-drama-system projects folder Studio scans for delivered films; read-only.
WORKSPACE_ROOT=
# Local media tier: hardlink snapshots of imported episodes, same volume as the
# workspace (default .uploads/local). Rendered ads still go to the media bucket.
STUDIO_LOCAL_MEDIA_DIR=
# Scratch for frame strips and ad segments (default: the OS temp dir).
STUDIO_WORK_DIR=

# --- Segment a film (decision 2026-09-23) --------------------------------------
# Studio runs the drama-remix cut-only scripts as background jobs inside a film's
# cut/ folder (a synced copy in cut/scripts/). The interpreter they run under:
# the pipeline's README names the system Python 3.12 with faster-whisper, opencv
# and numpy (no venv). Default: `python` on PATH.
STUDIO_PIPELINE_PYTHON=
# The drama-remix checkout (its own git repo) the scripts are synced from and
# whose git sha a run records (lib/python.ts dramaRemixRoot). Default: the
# `drama-remix` folder beside WORKSPACE_ROOT's parent (mini-drama-system/
# drama-remix) when it exists, else the sibling checkout
# ../Pulsar-Workspace/mini-drama-system/drama-remix of this repo. A dirty
# working tree refuses a run unless the run's settings allow it.
DRAMA_REMIX_ROOT=
# Where the machine-wide .heavy-lock.json lives (one whisper index, render or
# QA at a time across Studio and Claude Code sessions). Default: the folder
# above WORKSPACE_ROOT (mini-drama-system).
HEAVY_LOCK_ROOT=
# Git for Windows' bash for index_cut.sh; found beside git when unset.
STUDIO_BASH=

# --- Narrated mode (decision 2026-09-23 "Narrated mode in Studio") -------------
# The writing steps (the script read, each episode's prep) are headless Claude
# Code sessions Studio starts itself in the film folder: the Claude Agent SDK
# (@anthropic-ai/claude-agent-sdk, which ships its own Claude Code binary),
# else a `claude` CLI. They run on the Claude SUBSCRIPTION login: the
# session's environment is an allow-list (no ANTHROPIC_*, no key below, none
# of a parent Claude Code session's CLAUDECODE / CLAUDE_CODE_* variables), and
# a session that reports an API key source is stopped, so log in once with
# `claude` on this machine (CLAUDE_CONFIG_DIR is passed through if set). One
# writing session at a time machine-wide (<HEAVY_LOCK_ROOT>/.studio-writing/).
# Optional: a claude executable to use instead of the SDK's own (it is also
# the CLI fallback when the SDK cannot load).
STUDIO_CLAUDE_CLI=
# The GPU venv's python for the picture lane (clean_lbl.py, track_faces.py).
# Default: mini-drama-analysis/.gpu-venv/Scripts/python.exe beside
# mini-drama-system, when it is there.
STUDIO_GPU_PYTHON=
# audio-separator for the stems; default beside STUDIO_GPU_PYTHON.
STUDIO_AUDIO_SEPARATOR=
# Server only. The narration voice (tts_narration.py) sees this key and only
# that step does; Studio puts no .env into its projects.
ELEVENLABS_API_KEY=
# ElevenLabs price in cents per 1,000 characters, for the cost on each
# tts_line job row. Unset: the row records the characters and says the price
# is not set (no guess).
ELEVENLABS_CENTS_PER_1K_CHARS=
# Server only. TypeSafe Jev for narr_lint / scene_audit / continuity /
# ledger_check / preflight; handed to those steps only (jev.py also finds
# mini-drama-system/.env on its own).
TYPESAFE_API_KEY=

# --- TikTok launch (decision 2026-09-09) --------------------------------------
# Fixture mode ALWAYS launches into the fake TikTok inside the process: the
# in-memory store forgets a launch on restart, and a forgotten launch is a
# duplicate launch waiting to happen. Real objects need DATA_SOURCE=supabase.
# sandbox (default) = fake money, isolated host; production = real ads.
TIKTOK_MODE=sandbox
# The developer app's id and secret (business-api.tiktok.com), shared by the
# team through a password manager, never through git. Same app as Pulsar Grow.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Sandbox only: a token + advertiser id pasted from the developer portal
# (sandbox has no consent screen). Leave blank in production, where the admin
# "Connect TikTok" flow writes .tokens.json on the server.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
# Must EXACTLY match a redirect URI registered on the TikTok app. Blank derives
# <host>/api/admin/tiktok/callback from the request.
TIKTOK_REDIRECT_URI=
# Engineers only: TIKTOK_LIVE=1 with TIKTOK_MODE=sandbox reaches the sandbox
# from fixture mode. Production is refused in fixture mode regardless.
TIKTOK_LIVE=
# Fake TikTok switches (fixture mode and tests only): TIKTOK_FAKE_REVIEW=reject
# rejects every ad; TIKTOK_FAKE_ACCOUNT=suspended models a punished ad account
# (status updates answer 0 and are ignored). Leave blank.
TIKTOK_FAKE_REVIEW=
TIKTOK_FAKE_ACCOUNT=
# SCHEDULER_DISABLED=1 stops the in-process launch/review/metrics heartbeat
# (for an environment that is not one long-lived Node process).
SCHEDULER_DISABLED=
# Disabled by default. Set to 1 only after inspecting previously approved,
# unfinished earlier campaign launches and their signed budgets. This allows
# the old worker to resume uploads and automatic copies; unset after recovery.
LEGACY_PROMO_RECOVERY=
# PROMO_RENDER=off skips ffmpeg rendering (tests, machines without ffmpeg).
PROMO_RENDER=

# --- Transcription (decision 2026-09-15; docs/transcription.md) ---------------
# Fills a script-less episode from its audio via the explicit Materials
# button; never silent. local-whisper = faster-whisper on this machine
# (spends nothing, works in demo mode); openai = whisper-1 over the API
# (a real model call: needs OPENAI_API_KEY above, and demo replay refuses
# it unless DEMO_REPLAY=0). Unset = the button shows an unavailable state.
STUDIO_ASR_PROVIDER=
# local-whisper: a python with faster-whisper installed (pip install
# faster-whisper). Falls back to STUDIO_ALIGN_PYTHON, then plain "python".
STUDIO_ASR_PYTHON=
# Whisper model for transcription (default: small; falls back to
# STUDIO_WHISPER_MODEL). large-v3 is more accurate and much slower on CPU.
STUDIO_ASR_MODEL=

# --- Dubbing (not used by Studio V1) -----------------------------------------
# Dubbing / TTS provider is an OPEN decision - see docs/build-plan.md.
DUBBING_API_KEY=

# --- Unified Meta launch -----------------------------------------------------
# Server only. Fixture mode always uses the endpoint fake, even with a token.
META_ACCESS_TOKEN=
META_API_VERSION=v26.0
# Leave blank until the approved deployment is ready for real Meta writes.
# Enabling this switch does not replace company assignment and launch approval.
META_LIVE_WRITES=
# Fixture only: how the endpoint fake behaves when a clip is posted organically.
# Blank = the happy path. ig_error ends the Instagram Reel container in ERROR;
# fb_throttle rate-limits the first Facebook /videos upload once, so the row
# stays "publishing" and the scheduler sweep finishes it.
META_FAKE_PUBLISH=
# Optional Studio MCP bridge: expose only when connecting a Studio client.
STUDIO_LAUNCH_MCP_ENABLED=

# --- The crazydramas connection (decision 2026-09-23; docs/crazydramas-connection.md) -----
# Read-only: Studio reads the PUBLIC crazydramas API (the catalog and one series
# per slug) and keeps what it read as snapshots. No credential of any kind in
# this phase. The site's origin, not a secret; default https://crazydramas.com.
CRAZYDRAMAS_BASE_URL=
# Fixture mode never fetches (lib/crazydramas/fake.ts answers). Engineers only:
# CRAZYDRAMAS_LIVE_READ=1 allows the public reads from fixture mode; tests refuse
# the live transport regardless.
CRAZYDRAMAS_LIVE_READ=

# --- Upload to crazydramas (decision 2026-09-23; docs/crazydramas-connection.md) ----
# crazydramas' Studio API token (64 hex, from Jayden over a private channel). Read
# only in lib/crazydramas/transport.ts; never logged, stored or returned. With it
# the status reads use the authenticated series read (drafts visible); without it
# the public read stands in and every write is disabled.
CRAZYDRAMAS_STUDIO_TOKEN=
# Real writes (create a draft series, upload to Mux, publish) need BOTH
# DATA_SOURCE=supabase AND CRAZYDRAMAS_LIVE_WRITES=enabled. Fixture mode writes to
# the fake only (CRAZYDRAMAS_LIVE_READ=1 included); tests refuse the live transport.
CRAZYDRAMAS_LIVE_WRITES=
# 1 once the paywall fix is live on crazydramas: paid episodes (past the free count)
# then publish without the extra confirm.
CRAZYDRAMAS_PAYWALL_LIVE=
# off disables the background uploader and its resume on the scheduler's tick.
CRAZYDRAMAS_UPLOADS=
