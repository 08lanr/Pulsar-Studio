# Copy to .env.local. Never commit .env.local.

# --- Supabase (shared project with Reach and Stage) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - used by ingest jobs and admin routes only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data source -------------------------------------------------------------
# fixture  = render from the bundled sample title (no Supabase needed; default in dev)
# supabase = read/write the shared Supabase project
DATA_SOURCE=fixture

# --- Video (Cloudflare Stream) -----------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# --- AI providers -------------------------------------------------------------
# anthropic (default), openai or deepseek. Only the chosen provider's key is read.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only for identity-linked keys: the workspace the requests act in
# (console.anthropic.com -> Settings -> Workspaces, id starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
# platform.deepseek.com -> API keys. Defaults: deepseek-chat (fast), deepseek-reasoner (strong).
DEEPSEEK_API_KEY=
# Optional; the OpenAI-compatible host, https://api.deepseek.com unless set.
DEEPSEEK_BASE_URL=
# Optional provider-specific overrides. Defaults are selected in lib/llm.ts.
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

# --- TikTok launch (decision 2026-09-09) --------------------------------------
# Fixture mode ALWAYS launches into the fake TikTok inside the process: the
# in-memory store forgets a launch on restart, and a forgotten launch is a
# duplicate launch waiting to happen. Real objects need DATA_SOURCE=supabase.
# sandbox (default) = fake money, isolated host; production = real ads.
TIKTOK_MODE=sandbox
# The developer app's id and secret (business-api.tiktok.com), shared by the
# team through a password manager, never through git. Same app as Pulsar Grow.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Sandbox only: a token + advertiser id pasted from the developer portal
# (sandbox has no consent screen). Leave blank in production, where the admin
# "Connect TikTok" flow writes .tokens.json on the server.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
# Must EXACTLY match a redirect URI registered on the TikTok app. Blank derives
# <host>/api/admin/tiktok/callback from the request.
TIKTOK_REDIRECT_URI=
# Engineers only: TIKTOK_LIVE=1 with TIKTOK_MODE=sandbox reaches the sandbox
# from fixture mode. Production is refused in fixture mode regardless.
TIKTOK_LIVE=
# Fake TikTok switches (fixture mode and tests only): TIKTOK_FAKE_REVIEW=reject
# rejects every ad; TIKTOK_FAKE_ACCOUNT=suspended models a punished ad account
# (status updates answer 0 and are ignored). Leave blank.
TIKTOK_FAKE_REVIEW=
TIKTOK_FAKE_ACCOUNT=
# SCHEDULER_DISABLED=1 stops the in-process launch/review/metrics heartbeat
# (for an environment that is not one long-lived Node process).
SCHEDULER_DISABLED=
# Disabled by default. Set to 1 only after inspecting previously approved,
# unfinished earlier campaign launches and their signed budgets. This allows
# the old worker to resume uploads and automatic copies; unset after recovery.
LEGACY_PROMO_RECOVERY=
# PROMO_RENDER=off skips ffmpeg rendering (tests, machines without ffmpeg).
PROMO_RENDER=

# --- Transcription (decision 2026-09-15; docs/transcription.md) ---------------
# Fills a script-less episode from its audio via the explicit Materials
# button; never silent. local-whisper = faster-whisper on this machine
# (spends nothing, works in demo mode); openai = whisper-1 over the API
# (a real model call: needs OPENAI_API_KEY above, and demo replay refuses
# it unless DEMO_REPLAY=0). Unset = the button shows an unavailable state.
STUDIO_ASR_PROVIDER=
# local-whisper: a python with faster-whisper installed (pip install
# faster-whisper). Falls back to STUDIO_ALIGN_PYTHON, then plain "python".
STUDIO_ASR_PYTHON=
# Whisper model for transcription (default: small; falls back to
# STUDIO_WHISPER_MODEL). large-v3 is more accurate and much slower on CPU.
STUDIO_ASR_MODEL=

# --- Dubbing (not used by Studio V1) -----------------------------------------
# Dubbing / TTS provider is an OPEN decision - see docs/build-plan.md.
DUBBING_API_KEY=

# --- Unified Meta launch -----------------------------------------------------
# Server only. Fixture mode always uses the endpoint fake, even with a token.
META_ACCESS_TOKEN=
META_API_VERSION=v26.0
# Leave blank until the approved deployment is ready for real Meta writes.
# Enabling this switch does not replace company assignment and launch approval.
META_LIVE_WRITES=
# Optional Studio MCP bridge: expose only when connecting a Studio client.
STUDIO_LAUNCH_MCP_ENABLED=
