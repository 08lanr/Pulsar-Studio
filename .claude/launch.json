{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3200
    },
    {
      "name": "studio-fixture",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set DATA_SOURCE=fixture&& set TIKTOK_MODE=sandbox&& npm run dev"
      ],
      "port": 3200
    },
    {
      "name": "studio-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3200
    },
    {
      "name": "studio-attach",
      "url": "http://localhost:3200"
    }
  ]
}
