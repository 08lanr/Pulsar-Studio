node_modules/
.next/
.next-production/
.next-codex/
out/
.next-redesign*/

# Secrets. Backups of .env.local hold the same keys - never committable.
.env.local
.env.local.*
.env*.bak

# Next.js auto-generated types + TypeScript incremental cache
next-env.d.ts
*.tsbuildinfo

# Local runtime state (uploads, scratch renders). Supabase is the source of truth.
.data/
.uploads/
tmp/
output/

# Supabase CLI local state
supabase/.branches
supabase/.temp

# Claude Code machine-specific settings (keep launch.json, ignore local prefs)
.claude/settings.local.json
.venv-dub/

# Local tooling and generated media - never committed.
.codex-tools/
video_output/

# Editor local history and stray server logs.
.history/
.server-out.log

# Crawl logs are per-run noise; the raw JSON and snapshots are kept.
data/research/raw/*.log

# Playwright default output (the root config writes under tmp/).
test-results/
.next-build/
